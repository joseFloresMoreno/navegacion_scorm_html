  "audioSrc": "",
  "convertedHtml": "<div class=\"slide-content\"><div class=\"section-header\" style=\"background: linear-gradient(to right, var(--color-primary-dark), var(--color-primary)); padding: 40px 20px; text-align: center; color: white; border-radius: 15px; margin-bottom: 40px;\"><h1 class=\"section-title\" style=\"color: var(--color-accent); margin-bottom: 10px; font-size: 3em;\">💡 ¿Qué es?</h1><p class=\"section-subtitle\" style=\"color: white; font-size: 1.5em; max-width: 800px; margin: 0 auto;\">Eficiencia operativa</p></div><div style=\"text-align: center; margin-bottom: 30px;\"><p style=\"font-size: 1.3em; color: var(--color-primary-dark);\">🎯 Veamos un ejemplo.</p></div><h3 style=\"text-align: center; color: var(--color-primary); margin-bottom: 30px; font-size: 1.8em;\">Caso de desarrollo de Curso de 30 pantallas:</h3><div class=\"content-grid-2col\" style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 40px;\"><div class=\"card-info\" style=\"background-color: #f8f9fa; border-left: 5px solid var(--color-accent); padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);\"><h4 style=\"color: var(--color-primary-dark); margin-bottom: 15px; font-size: 1.5em;\">📚 Formato animado (estándar DAM): <span style=\"color: var(--color-accent-alt);\">Total 100 horas</span></h4><ul style=\"list-style: none; padding-left: 0;\"><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Diseño Instruccional: <strong style=\"color: var(--color-primary);\">25 horas</strong></li><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Diseño Gráfico: <strong style=\"color: var(--color-primary);\">50 horas</strong></li><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Revisiones/ajustes: <strong style=\"color: var(--color-primary);\">25 horas</strong></li></ul></div><div class=\"card-info\" style=\"background-color: #f8f9fa; border-left: 5px solid var(--color-secondary); padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);\"><h4 style=\"color: var(--color-primary-dark); margin-bottom: 15px; font-size: 1.5em;\">⚡ Formato Curso Responsivo IA: <span style=\"color: var(--color-secondary);\">Total 50 horas</span></h4><ul style=\"list-style: none; padding-left: 0;\"><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Diseño Instruccional: <strong style=\"color: var(--color-primary);\">15 horas</strong></li><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Diseño Gráfico: <strong style=\"color: var(--color-primary);\">25 horas</strong></li><li style=\"margin-bottom: 10px; font-size: 1.1em; color: #555;\">• Revisiones/ajustes: <strong style=\"color: var(--color-primary);\">10 horas</strong></li></ul></div></div><div class=\"feature-grid\" style=\"text-align: center; background-color: var(--color-primary); color: white; padding: 30px; border-radius: 10px; margin-bottom: 40px;\"><p style=\"font-size: 1.6em; font-weight: bold; margin: 0;\">Menos tiempo de producción, mayor control del proceso y cursos listos para cualquier LMS.</p></div><div class=\"card-info\" style=\"background-color: var(--color-accent); color: var(--color-primary-dark); padding: 25px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);\"><h4 style=\"margin-bottom: 10px; font-size: 1.4em;\"><strong style=\"color: var(--color-primary-dark);\">¡Importante!</strong></h4><p style=\"font-size: 1.1em; line-height: 1.6;\">Los tiempos no consideran desarrollo de recursos extras como incorporar videos, animaciones o gráficas completas.</p></div></div>"
},
